# Copy to .env and fill in.
PORT=4000

# Postgres holds users (like the CMS `users` table). The database is created on first start if missing.
DATABASE_URL=postgres://<user>:<password>@localhost:5432/books_poc

# Mongo holds books (like the CMS content collections).
MONGO_URL=mongodb://localhost:27017
MONGO_DB=books_poc

# Signs user JWTs. Any long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Where the agent service listens, and the secret only the relay knows.
# The same INTERNAL_AUTH_SECRET must be set in books-agent/.env.
AGENT_URL=http://localhost:8001
INTERNAL_AUTH_SECRET=change-me-shared-with-the-agent
