# Copy to .env and fill in. Loaded before Continuum is imported, so Continuum's own settings live here too.

# ---- This service -------------------------------------------------------------
AGENT_PORT=8001
# Must equal INTERNAL_AUTH_SECRET in books-backend/.env — only the backend relay may call us.
INTERNAL_AUTH_SECRET=change-me-shared-with-the-agent
BACKEND_GRAPHQL_URL=http://localhost:4000/graphql
# Agent-owned store: conversations, events (transcript), checkpoints, pending actions.
# The database is created on first start if missing.
AGENT_DATABASE_URL=postgres://<user>:<password>@localhost:5432/agent_poc
REDIS_URL=redis://localhost:6379/0

# ---- LLM switch -----------------------------------------------------------------
# bedrock  -> Claude on Bedrock through our registered "bedrock/" provider (uses ~/.aws credentials)
# gateway  -> everything through the Continuum Smart Gateway (set SMART_GATEWAY_URL + key below)
LLM_BACKEND=bedrock
AWS_REGION=us-east-1
# Named profile from ~/.aws/credentials (leave empty to use the default credential chain)
AWS_PROFILE=dev
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
GATEWAY_MODEL=bedrock/us.anthropic.claude-haiku-4-5-20251001-v1:0

# ---- Continuum settings -----------------------------------------------------------
# Empty disables the gateway (Continuum treats an empty value as off). Fill both for LLM_BACKEND=gateway.
SMART_GATEWAY_URL=
SMART_GATEWAY_API_KEY=
SMART_LAYER_ENABLED=false
# Short-term chat history lives in Continuum's Redis session. Your Redis is on 6379 (Continuum defaults to 6380).
SESSION_ENABLED=true
SESSION_REDIS_HOST=localhost
SESSION_REDIS_PORT=6379
SESSION_TTL_SECONDS=172800
# Long-term memory (mem0 + Qdrant) and Langfuse are off for the POC.
MEMORY_ENABLED=false
LANGFUSE_ENABLED=false
LOG_LEVEL=INFO
# Local only: your Redis has no password, and Continuum refuses that unless this override is set.
# In any shared or deployed environment, remove this and set SESSION_REDIS_PASSWORD instead.
CONTINUUM_ALLOW_INSECURE=1
